# 환경 변수 · 시크릿 (그라운드 룰: 절대 커밋 금지)
.env

# 가상환경
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 도구 캐시 (uv.lock은 커밋 대상 — 그라운드 룰)
.pytest_cache/
.ruff_cache/

# 스캔 결과 DB (런타임 산출물 — 각자 로컬에서 생성됨. WAL 사이드카 포함)
data/*.db
data/*.db-wal
data/*.db-shm
# 이력을 비우려고 옆으로 밀어둔 백업본도 같이 제외 — 실수로 커밋되면 남의 로컬
# 스캔 기록이 레포에 박힌다.
data/*.bak

# 도구 설정
.claude/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
