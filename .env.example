# Supply-Unchained 환경변수 템플릿 (실제 .env 는 커밋 금지 — 그라운드 룰)
# 아래 값은 코드에서 os.environ / os.getenv 로 읽는 변수 전부다. 기본값은 코드의 기본값이다.

# ── 공통 ──

# 스캔 결과 SQLite 경로. 기본: data/supply_unchained.db
# 읽는 곳: api/storage.py (API 서버와 CLI 가 같은 DB 를 본다)
SU_DB_PATH=data/supply_unchained.db

# CLI 가 바라볼 API 주소. 기본: http://localhost:8000 (SU_API_URL 이 설정돼 있으면 CLI 는 서버 경로로 동작)
# 읽는 곳: cli/su_scan.py. 미설정이면 서버 없이 로컬에서 직접 스캔한다.
SU_API_URL=http://localhost:8000

# 오프라인 데모 모드. "1" / "true" / "yes" (API) 또는 "1" (CLI 일부 경로) 이면 외부 API(OSV/PyPI) 를
# 호출하지 않고 결정적 mock 판정을 낸다. CI 의 supply-chain-scan 이 이 값으로 돈다. 기본: 꺼짐.
# 읽는 곳: api/routers/scan.py, api/routers/proxy.py, cli/su_scan.py
# SU_OFFLINE_DEMO=1

# ── API: 정적분석(bandit) 예산 ──

# 파일 하나당 bandit 실행 예산(초). 기본: 20
# 읽는 곳: api/routers/scan.py
# SU_BANDIT_BUDGET=20

# bandit 에 넘기는 파일 최대 크기(KB). 이보다 큰 파일은 정적분석에서 뺀다. 기본: 64
# 읽는 곳: api/routers/scan.py
# SU_BANDIT_MAX_FILE_KB=64

# ── 통합 후 적용 (설계 문서 docs/design/multi-ecosystem.md §2.3) ──
# 아래 두 변수는 아직 코드에 없다. 다생태계 통합 후에 읽기 시작한다. 지금 설정해도 효과는 없다.

# 스캔할 아티팩트 최대 크기(MB). 이보다 큰 패키지는 내려받아 분석하지 않는다. (통합 후 적용)
# SU_MAX_ARTIFACT_MB=100

# 정적분석을 끝내지 못한 패키지(layer_errors 에 static: 이 남은 경우)를 어떻게 할지.
# 설계 원칙: "못 봤다"는 "깨끗하다"가 아니다. 프록시 기본값은 차단. (통합 후 적용)
# SU_UNSCANNED_POLICY=block
